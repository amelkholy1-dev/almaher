ADMIN_PASS=غيّرها-لكلمة-قوية      # 10 حروف على الأقل، بتتحوّل لـ hash في أول تشغيل
SESSION_SECRET=حروف-عشوائية-طويلة-16-على-الأقل
SITE_URL=https://ahmedalkholy.com  # عشان صورة معاينة الرابط (واتساب/لينكد إن)
